{
  "name": "noteforge",
  "version": "1.2.0",
  "description": "NoteForge — local-first note-taking app inspired by Obsidian/Notion: markdown, wikilinks, backlinks, tags, graph view",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run-node-tests.mjs",
    "test:browser": "playwright test --project=features",
    "test:budget": "node test/bundle-budget.mjs",
    "test:all": "npm run check && npm run typecheck && npm test && playwright test --project=features --project=a11y --project=durability-chromium --project=durability-firefox --project=durability-webkit && npm run build && npm run test:budget",
    "lint": "biome lint",
    "typecheck": "node test/typecheck-ratchet.mjs",
    "format": "biome format --write",
    "check": "biome ci && node scripts/build-icons.mjs --check",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:e2e": "playwright test",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.63.0",
    "lucide-static": "1.48.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "keywords": [
    "notes",
    "notion",
    "obsidian",
    "knowledge-base",
    "markdown",
    "wikilinks"
  ],
  "author": "Dave",
  "license": "MIT"
}
